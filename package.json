{
  "name": "react-example",
  "private": true,
  "version": "1.2.4-RELEASE",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node tests/e2e-check.mjs && node tests/master-audit.mjs && node tests/ai-input-moderation-130-check.mjs && node tests/admin-safety-check.mjs",
    "test:ai": "node tests/ai-input-moderation-130-check.mjs",
    "test:admin": "node tests/admin-safety-check.mjs",
    "backup": "node scripts/backup.mjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@studio-freight/lenis": "^1.0.42",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "nodemailer": "^8.0.4",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "vite": "^6.2.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "better-sqlite3@11.3.0": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.5.4": true
  },
  "volta": {
    "node": "20.20.2"
  }
}
