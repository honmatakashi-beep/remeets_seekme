# ==============================================================================
# 🕊️ ReMEETs（再会のボトルメール）環境変数設定テンプレート (.env.example)
# ==============================================================================

# 【基本サーバー設定】
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
JWT_SECRET=your_jwt_secret_key_random_64chars

# 【データベース基盤 (PostgreSQL / Cloud SQL / Supabase)】
# ※ 未設定時はローカルSQLite (kizuna.db) が自動使用されます
DATABASE_URL=postgresql://postgres:your_password@your_db_host:5432/remeets_db

# 【AI検閲・防衛エンジン (Google Gemini API)】
GEMINI_API_KEY=your_gemini_api_key_here

# 【決済代行インフラ (Stripe)】
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here

# 【メール配信インフラ (Resend / SendGrid)】
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=ReMEETs事務局 <noreply@your-domain.com>

# 【SNS OAuth 認証基盤】
# 1. LINE Login (LINE Developers Console)
LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# 2. Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

