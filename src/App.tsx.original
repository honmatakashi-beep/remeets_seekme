                    <p className="text-[9px] text-black/55 text-center leading-normal mt-2">
                      つきまとい者や冷やかしの投稿は、本人には「成功」と自画自賛させたまま、裏側で自動隔離。
                    </p>
                  </div>
                );
              case 11: // 非機能①（最高レベルのセキュリティ）
                return (
