              </div>
              <p className="text-xs text-black/75 leading-relaxed font-sans">
                ボトルメールのやりとりを開始するには、お相手が設定した「共通の思い出」に関するクイズに完全正解する必要があります。第三者が偶然アクセスしたり、ストーカーが推測して接触することを100.00%不可能にします。
              </p>
            </div>

            <div className="p-6 rounded-2xl border border-brand-border bg-slate-50/50 space-y-3">
              <div className="flex items-center gap-2">
                <span className="w-6 h-6 bg-brand-primary/10 text-brand-primary rounded-full flex items-center justify-center text-xs font-bold font-mono">2</span>
                <span className="font-serif font-bold text-sm text-black">実名照合警告システム</span>
              </div>
              <p className="text-xs text-black/75 leading-relaxed font-sans">
                ボトル投函時やお相手の設定時に「本名」を入力しようとすると、日本の常用姓名照合フィルターが瞬時に検知。警告を促しニックネーム等への変更を指示することで、実名が一般に晒されるリスクを水際で防御します。
              </p>
            </div>

            <div className="p-6 rounded-2xl border border-brand-border bg-slate-50/50 space-y-3">
              <div className="flex items-center gap-2">
                <span className="w-6 h-6 bg-brand-primary/10 text-brand-primary rounded-full flex items-center justify-center text-xs font-bold font-mono">3</span>
                <span className="font-serif font-bold text-sm text-black">直接連絡先（SNS・電話）自動伏字化</span>
              </div>
              <p className="text-xs text-black/75 leading-relaxed font-sans">
                LINE ID、電話番号、メールアドレス等の直接的な個人間プロファイルを全テキストから検閲スキャン。不適切な勧誘や密室となる外部アプリへの強引な誘い込みを防ぐため、「****」へと自動上書き・マスキングを行います。
              </p>
            </div>

            <div className="p-6 rounded-2xl border border-brand-border bg-slate-50/50 space-y-3">
              <div className="flex items-center gap-2">
                <span className="w-6 h-6 bg-brand-primary/10 text-brand-primary rounded-full flex items-center justify-center text-xs font-bold font-mono">4</span>
                <span className="font-serif font-bold text-sm text-black">Gemini AI による執念・付きまとい監視</span>
              </div>
              <p className="text-xs text-black/75 leading-relaxed font-sans">
                文章に流れる「執拗な感情（リベンジポルノ・恐怖売渡を目的とするストーキングなど）」の文脈を、最先端のGemini AIが裏でリアルタイム解析。高リスクと判定されたアカウントは自動的に「ステルス隔離（シャドウ）」されます。
              </p>
            </div>
          </div>
        </section>

        <section className="space-y-4 pt-6">
          <h2 className="text-lg font-serif font-bold border-b border-brand-border pb-2 text-black">
            🔞 18歳未満（高校生含む）の利用制限
          </h2>
          <p className="text-xs text-black/75 leading-relaxed font-serif text-black">
          </p>
        </section>

        <section className="space-y-4 pt-6">
          <h2 className="text-lg font-serif font-bold border-b border-brand-border pb-2 text-black">
            ✍️ デジタル署名による説明責任証明
          </h2>
          <p className="text-xs text-black/75 leading-relaxed font-serif text-black">
            お相手とメッセージの送受信を開始するタイミングで、法令違反行為を行わないことに対する誓約（電子宣誓）をおこなうと同時に、指・ペンを使った『自筆デジタル署名』の入力を義務付けています。署名データは、合意日時やIPアドレスと共に厳重に保存され、不法行為発生時には司法機関に提出可能なフォレンジック証拠となります。
          </p>
        </section>

        <section className="space-y-4 pt-6 bg-slate-900 text-white rounded-3xl p-8 border border-slate-800 shadow-lg">
          <div className="flex items-center gap-2">
            <ShieldAlert size={20} className="text-amber-400" />
            <h3 className="text-base font-serif font-bold text-white">警察等司法機関との堅固な協調体制</h3>
          </div>
          <p className="text-xs text-slate-300 leading-relaxed font-serif text-white/95">
            万が一、利用を仮装した悪質なストーキング行為、嫌がらせ、なりすまし等が発生した場合、各都道府県警察の生活安全課、サイバー犯罪対策課などの刑事捜査事項照会に対して、私たちは最高速度で応じるポータルAPIを用意しています。
            提出書類の受理後、瞬時に署名ログ・接続端末IP・アクセス履歴をフォレンジック抽出して提供し、徹底的な犯人検挙、犯罪撲滅に完全協力することをお約束いたします。
          </p>
        </section>

        <div className="pt-6 text-center">
          <p className="text-xs text-black/55 mb-2">何らかの不都合や個人情報の違法掲載、削除が必要なボトルがございましたら：</p>
          <Link to="/deletion-request" className="btn-primary inline-flex animate-none text-xs">
            削除申請（オプトアウト）はこちら
          </Link>
        </div>
      </div>
    </div>
  </div>
);

const DeletionRequestPage = () => {
  const { user, token } = useAuth();
  const [postId, setPostId] = useState('');
  const [name, setName] = useState(user?.nickname || user?.username || '');
  const [email, setEmail] = useState(user?.email || '');
  const [url, setUrl] = useState('');
  const [content, setContent] = useState('');
  const [reason, setReason] = useState('');
  const [explanation, setExplanation] = useState('');
  const [status, setStatus] = useState<'idle' | 'submitting' | 'success' | 'error'>('idle');
  const [errorMsg, setErrorMsg] = useState('');
  const navigate = useNavigate();

  useEffect(() => {
    if (user) {
      if (!name) setName(user.nickname || user.username || '');
      if (!email) setEmail(user.email || '');
    }
  }, [user]);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!token) {
      setErrorMsg('削除申請を送信するには、ログインしている必要があります。');
      setStatus('error');
      return;
    }
    if (!postId || !reason || !content) {
      setErrorMsg('必須項目（ボトルID、ボトルの特徴、申請理由）をご入力ください。');
      setStatus('error');
      return;
    }

    setStatus('submitting');
    setErrorMsg('');

    try {
      const res = await fetch('/api/deletion-requests', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({
          post_id: parseInt(postId),
          name: name || '匿名申請者',
          url: url || `https://remeets.dev/post/${postId}`,
          content: content,
          reason: reason,
          explanation: explanation,
          email: email
        })
      });

      if (!res.ok) {
        const body = await res.json();
        throw new Error(body.error || '申請の送信に失敗しました。');
      }

      setStatus('success');
    } catch (err: any) {
      setStatus('error');
      setErrorMsg(err.message || 'エラーが発生しました。');
    }
  };

  return (
    <div className="max-w-2xl mx-auto px-6 py-12 md:py-24 text-black font-sans">
      <Link to="/" className="inline-flex items-center gap-2 text-sm opacity-60 hover:opacity-100 mb-6 font-serif text-black">
        <ArrowLeft size={16} />
        <span>トップへ戻る</span>
      </Link>
      <div className="glass-card p-8 md:p-12 space-y-8 bg-white rounded-3xl border border-brand-border">
        <div>
          <h1 className="text-2xl font-bold text-black font-serif tracking-tight text-black">個人情報のオプトアウト ＆ 削除申請</h1>
        </div>

        {status === 'success' ? (
          <motion.div 
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            className="flex flex-col items-center justify-center p-8 bg-emerald-50 rounded-2xl border border-emerald-100 space-y-4 text-center text-black"
          >
            <CheckCircle2 size={48} className="text-emerald-500" />
            <h2 className="text-lg font-serif font-bold text-emerald-800">削除申請を正常に受理いたしました</h2>
            <p className="text-xs text-emerald-700/80 max-w-md leading-relaxed text-black">
              ご提出いただいた対象ボトル「ID: #${postId}」に関する削除申請を受け付けました。
              運営セキュリティ安全委員会により文面の検証を行い、誹謗中傷、本人の特定、その他安全規約に基づき不相当と認められた場合は、通常24時間以内にただちに本データベースより完全な物理消去（または非公開化）処理を実行します。
              処置完了のご案内は、ご登録のメールアドレスまでお送りいたします。
            </p>
            <button onClick={() => navigate('/')} className="btn-primary mt-4 py-2.5 text-xs bg-emerald-600 hover:bg-emerald-700">
              トップページへ
            </button>
          </motion.div>
        ) : (
          <form onSubmit={handleSubmit} className="space-y-6">
            {!token && (
              <div className="p-4 bg-amber-50 border border-amber-200 text-amber-800 rounded-2xl flex items-start gap-3 text-xs leading-relaxed">
                <AlertCircle size={16} className="shrink-0 mt-0.5 text-amber-600" />
                <div>
                  <span>削除申請を行うにはログインが必要です。他者への嫌がらせ、無差別な申請アビューズを防止し、申請者の説明責任を記録するためご協力をお願いいたします。</span>
                  <div className="mt-2">
                    <Link to="/login" className="font-bold underline text-brand-primary">ログインはこちら →</Link>
                  </div>
                </div>
              </div>
            )}

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="space-y-1.5">
                <label className="text-[10px] font-bold text-black/70 uppercase tracking-widest block font-sans">対象ボトルのID（必須）</label>
                <input 
                  type="number"
                  required
                  placeholder="例: 42"
                  value={postId}
                  onChange={e => setPostId(e.target.value)}
                  className="w-full px-4 py-3 border border-brand-border rounded-xl bg-white text-xs text-black font-sans focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary"
                />
              </div>
              
              <div className="space-y-1.5">
                <label className="text-[10px] font-bold text-black/70 uppercase tracking-widest block font-sans">申請理由（必須）</label>
                <select 
                  required
                  value={reason}
                  onChange={e => setReason(e.target.value)}
                  className="w-full px-4 py-3 border border-brand-border rounded-xl bg-white text-xs text-black font-sans focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary"
                >
                  <option value="" disabled>選択してください</option>
                  <option value="個人を特定する情報の掲載（実名、あだ名、居住地等）">個人を特定する情報の掲載（実名、あだ名等）</option>
                  <option value="他者に対する誹謗中傷、プライバシー侵害">他者に対する誹謗中傷、プライバシー侵害</option>
                  <option value="ストーカー類似行為、一方的な付きまといの感情">ストーカー類似行為、一方的な付きまといの感情</option>
                  <option value="性的・暴力的な表現、公序良俗違反">性的・暴力的な表現、公序良俗違反</option>
                  <option value="誤認による投稿、本人が削除を希望">誤認による投稿、本人が削除を希望</option>
                  <option value="その他安全上のリスク">その他安全上のリスク</option>
                </select>
              </div>
            </div>

            <div className="space-y-1.5">
              <label className="text-[10px] font-bold text-black/70 uppercase tracking-widest block font-sans">対象ボトルの主な掲載内容（必須）</label>
              <textarea 
                required
                rows={3}
                placeholder="削除対象ボトルの特徴、大まかな思い出の手がかりなどを入力してください。これにより事務局が確実に該当ボトルを特定します。"
                value={content}
                onChange={e => setContent(e.target.value)}
                className="w-full px-4 py-3 border border-brand-border rounded-xl bg-white text-xs text-black font-sans focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary font-sans leading-relaxed resize-none"
              />
            </div>

            <div className="space-y-1.5">
              <label className="text-[10px] font-bold text-black/70 uppercase tracking-widest block font-sans">詳細な状況・オプトアウトを希望する背景（任意）</label>
              <textarea 
                rows={3}
                placeholder="「自分のフルネームが含まれてしまっているため、削除を希望する」等の詳細なご事情を入力してください。"
                value={explanation}
                onChange={e => setExplanation(e.target.value)}
                className="w-full px-4 py-3 border border-brand-border rounded-xl bg-white text-xs text-black font-sans focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary font-sans leading-relaxed resize-none"
              />
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="space-y-1.5">
                <label className="text-[10px] font-bold text-black/70 uppercase tracking-widest block font-sans">ご連絡用お名前</label>
                <input 
                  type="text"
                  placeholder="山田 太郎"
                  value={name}
                  onChange={e => setName(e.target.value)}
                  className="w-full px-4 py-3 border border-brand-border rounded-xl bg-white text-xs text-black font-sans focus:outline-none focus:border-brand-primary"
                />
              </div>

              <div className="space-y-1.5">
                <label className="text-[10px] font-bold text-black/70 uppercase tracking-widest block font-sans">ご連絡用メールアドレス</label>
                <input 
                  type="email"
                  placeholder="example@yourdomain.com"
                  value={email}
                  onChange={e => setEmail(e.target.value)}
                  className="w-full px-4 py-3 border border-brand-border rounded-xl bg-white text-xs text-black font-sans focus:outline-none focus:border-brand-primary"
                />
              </div>
            </div>

            {errorMsg && (
              <div className="p-4 bg-red-50 border border-red-100 rounded-xl flex items-center gap-3 text-red-600 text-xs">
                <AlertCircle size={14} className="shrink-0" />
                <span>{errorMsg}</span>
              </div>
            )}

            <button 
              type="submit" 
              disabled={status === 'submitting' || !token} 
              className="w-full py-3 bg-brand-dark hover:bg-brand-primary text-white rounded-xl text-xs font-bold transition-all cursor-pointer font-sans disabled:opacity-50"
            >
              {status === 'submitting' ? <RefreshCw className="animate-spin text-white mx-auto white" size={16} /> : '削除申請を安全に送信する'}
            </button>
          </form>
        )}
      </div>
    </div>
  );
};

const SuccessStoriesPage = () => {
  const stories = [
    {
      id: 1,
      tag: "同級生との再会",
      era: "1980年代後半",
      relationship: "中学時代の親友",
      title: "「思い出クイズ」が結びつけた、35年越しの奇跡の再会",
      participants: "佐藤 健 様（52歳）＆ 鈴木 信一郎 様（51歳）",
      description: "中学の卒業式以来、お互いに引越しを重ねてしまい連絡先が分からなくなっていました。他のSNSでは同姓同名が多く、確信が持てずにいましたが、鈴木様が流した『1980年代後半の〇〇中学校陸上部』のボトルを発見。『顧問の〇〇先生から最後に贈られた激励の言葉は？』という当事者しか絶対に知り得ないクイズに佐藤様が正解。安全に、そして懐かしい思い出に包まれながら、35年ぶりの暗号化チャットが開通しました。",
      bg: "bg-amber-50/40 border-amber-200"
    },
    {
      id: 2,
      tag: "恩師との絆",
      era: "1990年代半ば",
      relationship: "高校時代の部活の顧問、部員",
      title: "定年退職された恩師に、あの頃の感謝を届けたい",
      participants: "高橋 由美子 様（45歳）＆ 山本 栄治 先生（71歳）",
      description: "山本先生の定年退職のニュースを聞き、当時の部活（吹奏楽部）のメンバーで記念に連絡を取りたいと考えました。先生の実名は入れず、あだ名である『やまおに先生』と、1990年代に優勝した近畿大会の金賞エピソードを宛先ヒントにしてボトルを流しました。ある日、先生の娘さんがこのボトルを見つけ、お父様（山本先生）に伝えてクイズに挑戦。クイズは『当時のコンテストで演奏した自由曲の和名。そして金賞受賞後に先生が泣きながらメンバー全員に奢ってくれたアイスは？』というものでした。完全一致によってメッセージが開通。今は当時のメンバー一同で、先生を囲む同窓会を企画しています。",
      bg: "bg-indigo-50/30 border-indigo-200/50"
    },
    {
      id: 3,
      tag: "元職場の同僚",
      era: "2000年代初頭",
      relationship: "ベンチャー企業の創業メンバー",
      title: "会社統合で散り散りになった創業メンバーが再集結",
      participants: "渡辺 直樹 様（42歳）＆ 小林 誠 様（43歳）",
      description: "20年前、共に徹夜を乗り越えてサービスを作った創業期の仲間。会社が大手企業に吸収合併され、それぞれのキャリアへ進んだ後、連絡が途絶えていました。インターネットの海に、渡辺様が『2000年代初頭に渋谷区桜丘町の雑居ビルで一緒に働いていたエンジニアへ』と投函。クイズは『深夜3時、サーバーがクラッシュした時に全員で行った近くの神社の名前は？』。小林様が数年越しに見つけて正解。お互いの現在地から、お互いの家族のこと、最新のキャリアについて和やかにチャットを続けています。",
      bg: "bg-emerald-50/30 border-emerald-200/50"
    }
  ];

  return (
    <div className="max-w-4xl mx-auto px-6 py-12 md:py-24 space-y-12">
      <div className="text-center space-y-4 max-w-2xl mx-auto animate-fade-in">
        <span className="text-[10px] font-bold text-brand-primary uppercase tracking-[0.4em] block font-sans">
        </span>
        <h1 className="text-3xl md:text-4xl font-serif font-bold text-brand-dark">再会を果たした喜びの声</h1>
        <p className="text-xs md:text-sm text-brand-dark/60 font-sans leading-relaxed">
          不特定多数と無差別に出会う「出会い系」ではなく、<br className="hidden md:inline"/>
          現実世界で大切な思い出を共有していた特定の個人同士だけが、<br />
          多層セーフティによって100%安全にふたたび繋がることができた喜びのエピソードをご紹介します。
        </p>
      </div>

      <div className="space-y-8 animate-fade-in">
        {stories.map(story => (
          <div key={story.id} className={`p-8 border rounded-3xl space-y-4 ${story.bg} shadow-sm hover:shadow transition-all group`}>
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div className="flex items-center gap-2">
                <span className="text-[10px] font-bold text-brand-primary bg-brand-primary/5 border border-brand-primary/10 px-3 py-1 rounded-full font-sans uppercase tracking-widest">
                  {story.tag}
                </span>
                <span className="text-[10px] font-bold text-brand-dark/40 font-mono">
                  年代：{story.era} / 関係：{story.relationship}
                </span>
              </div>
              <span className="text-xs font-serif text-brand-dark/50 italic">Episode #{story.id}</span>
            </div>

            <div className="space-y-2">
              <h2 className="text-xl md:text-2xl font-serif font-bold text-brand-dark group-hover:text-brand-primary transition-colors">
                {story.title}
              </h2>
              <p className="text-xs font-bold text-brand-dark/70 font-sans">
                👤 ご紹介：{story.participants}
              </p>
            </div>

            <p className="text-xs md:text-sm text-brand-dark/80 leading-relaxed font-sans border-t border-brand-border/30 pt-4">
              {story.description}
            </p>
          </div>
        ))}
      </div>

      <div className="text-center py-12 bg-zinc-50 rounded-3xl border border-brand-border/40 p-8 space-y-6 max-w-2xl mx-auto">
        <h3 className="text-xl font-serif font-bold text-brand-dark">心の中で漂流している思い出はありませんか？</h3>
        <p className="text-xs text-brand-dark/60 leading-relaxed max-w-md mx-auto font-sans">
          もう二度と会えないかもしれない、そう思っている昔の友人や恩師へ。
        </p>
        <div className="flex justify-center gap-4">
          <Link to="/register" className="btn-primary text-xs px-6 py-3">
            無料会員登録して手紙を流す
          </Link>
          <Link to="/search" className="btn-secondary text-xs px-6 py-3 bg-white">
            誰かの手紙を探してみる
          </Link>
        </div>
      </div>
    </div>
  );
};



const AdminDeploymentGuideBlock = ({ 
  docType, 
  setDocType 
}: { 
  docType: 'deployment' | 'permit' | 'police' | 'consult' | 'matrix' | 'slides'; 
  setDocType: (val: 'deployment' | 'permit' | 'police' | 'consult' | 'matrix' | 'slides') => void;
}) => {
  const [markdown, setMarkdown] = React.useState<string>('');
  const [loading, setLoading] = React.useState<boolean>(true);
  const [activeSlideIdx, setActiveSlideIdx] = React.useState<number>(0);
