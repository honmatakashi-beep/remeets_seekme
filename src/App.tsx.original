                    to="/success-stories"
                    onClick={() => setIsMenuOpen(false)}
                    className="flex items-center gap-3 px-3 py-2.5 text-xs text-brand-dark/85 hover:text-brand-primary hover:bg-brand-primary/5 rounded-xl transition-all font-medium"
                  >
                    <Heart size={15} className="text-pink-400 shrink-0" />
                    <span>幸せな再会の物語</span>
                  </Link>

                  {/* 5. 安全への取り組み */}
                  <Link
                    to="/safety"
                    onClick={() => setIsMenuOpen(false)}
                    className="flex items-center gap-3 px-3 py-2.5 text-xs text-brand-dark/85 hover:text-emerald-700 hover:bg-emerald-500/5 rounded-xl transition-all font-medium"
                  >
                    <ShieldCheck size={15} className="text-emerald-500 shrink-0" />
                    <span>安全への取り組み</span>
                  </Link>

                  {/* 6. お問い合わせ */}
                  <Link
                    to="/contact"
                    onClick={() => setIsMenuOpen(false)}
                    className="flex items-center gap-3 px-3 py-2.5 text-xs text-brand-dark/85 hover:text-brand-primary hover:bg-brand-primary/5 rounded-xl transition-all font-medium"
                  >
                    <HelpCircle size={15} className="text-zinc-400 shrink-0" />
                    <span>お問い合わせ</span>
                  </Link>

                  {/* 7. 管理者ダッシュボード */}
                  {user?.role === 'admin' && (
                    <Link
                      to="/admin"
                      onClick={() => setIsMenuOpen(false)}
                      className="flex items-center gap-3 px-3 py-2.5 text-xs font-bold text-red-700 hover:bg-red-50 rounded-xl transition-all"
                    >
                      <Shield size={15} className="text-red-500 shrink-0" />
                      <span>管理者ダッシュボード</span>
                    </Link>
                  )}

                  {/* Logout/Login Buttons */}
                  <div className="border-t border-brand-border/40 my-1 pt-1">
                    {user ? (
                      <button
                        onClick={() => {
                          setIsMenuOpen(false);
                          logout();
                          navigate('/login');
                        }}
                        className="w-full flex items-center gap-3 px-3 py-2.5 text-xs text-rose-600 hover:bg-rose-50 rounded-xl transition-all font-bold cursor-pointer text-left"
                      >
                        <LogOut size={15} className="text-rose-400 shrink-0" />
                        <span>ログアウト</span>
                      </button>
                    ) : (
                      <div className="grid grid-cols-2 gap-1.5 p-1 mt-1 font-semibold">
                        <Link
                          to="/login"
                          onClick={() => setIsMenuOpen(false)}
                          className="flex items-center justify-center gap-1.5 py-2 text-xs text-brand-dark hover:bg-slate-100 rounded-xl transition-all text-center border border-brand-border font-bold"
                        >
                          <LogIn size={13} />
                          <span>ログイン</span>
                        </Link>
                        <Link
                          to="/register"
                          onClick={() => setIsMenuOpen(false)}
                          className="flex items-center justify-center gap-1.5 py-2 text-xs bg-brand-primary hover:bg-brand-dark text-white rounded-xl transition-all text-center font-bold"
                        >
                          <span>新規登録</span>
                        </Link>
                      </div>
                    )}
                  </div>
                </motion.div>
              </>
            )}
          </AnimatePresence>
        </div>
      </div>
    </nav>
  );
};

