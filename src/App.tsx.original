  const handleToggleHomeStats = async () => {
    const newValue = !statsEnabled;
    try {
      const res = await fetch('/api/admin/site-settings', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ key: 'show_home_stats', value: String(newValue) })
      });
      if (res.ok) {
        setStatsEnabled(newValue);
      } else {
        console.error('Failed to update stats toggle');
      }
    } catch (err) {
      console.error('Error toggling home stats', err);
    }
  };

  const fetchData = async () => {
    if (authLoading || !token || user?.role !== 'admin') return;
    setLoading(true);
    try {
      const [usersRes, postsRes, actionLogsRes, accessLogsRes, reportsRes, deletionRes, statsRes, ngWordsRes, contactsRes, successStoriesRes, securityRes, broadcastsRes, ageLogsRes, settingsRes] = await Promise.all([
        fetch('/api/admin/users', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/posts', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/action-logs', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/access-logs', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/reports', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/deletion-requests', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/stats', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/ng-words', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/contacts', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/success-stories', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/security-stats', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/broadcasts', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/age-verification-logs', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/site-settings')
      ]);

      if (usersRes.ok) setUsers(await usersRes.json());
      if (postsRes.ok) setPosts(await postsRes.json());
      if (actionLogsRes.ok) setActionLogs(await actionLogsRes.json());
      if (accessLogsRes.ok) setAccessLogs(await accessLogsRes.json());
      if (reportsRes.ok) setReports(await reportsRes.json());
      if (deletionRes.ok) setDeletionRequests(await deletionRes.json());
      if (broadcastsRes.ok) setBroadcasts(await broadcastsRes.json());
      if (ageLogsRes.ok) setAgeVerificationLogs(await ageLogsRes.json());
      if (statsRes.ok) {
        setStats(await statsRes.json());
      } else {
        console.error('Failed to fetch stats:', statsRes.status);
        // Set empty stats to avoid infinite loading
        setStats({
          summary: { totalUsers: 0, totalReunions: 0, todayPosts: 0 },
          recentReunions: [],
          postsToday: [],
          dailyStats: [],
          eraStats: [],
          regionStats: [],
          pathStats: [],
          refererStats: [],
          searchStats: [],
          deviceStats: []
        });
      }
      if (ngWordsRes.ok) setNgWords(await ngWordsRes.json());
      if (contactsRes.ok) setContacts(await contactsRes.json());
      if (successStoriesRes.ok) setSuccessStories(await successStoriesRes.json());
      if (securityRes.ok) setSecurityStats(await securityRes.json());
      if (settingsRes.ok) {
        const settings = await settingsRes.json();
        setStatsEnabled(settings.show_home_stats === 'true');
      }

      const [dbHealthRes, retentionRes, pageViewRes, heatmapRes, moderationRes, auditRes, funnelRes, durationRes, deletedArchiveRes] = await Promise.all([
        fetch('/api/admin/db-health', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/retention-stats', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/page-view-stats', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/activity-heatmap', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/moderation-queue', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/audit-logs', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/reunion-funnel', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/reunion-duration-stats', { headers: { 'Authorization': `Bearer ${token}` } }),
        fetch('/api/admin/deleted-posts-archive', { headers: { 'Authorization': `Bearer ${token}` } })
      ]);
      if (dbHealthRes.ok) setDbHealth(await dbHealthRes.json());
      if (retentionRes.ok) setRetentionStats(await retentionRes.json());
      if (pageViewRes.ok) setPageViewStats(await pageViewRes.json());
      if (heatmapRes.ok) setHeatmapData(await heatmapRes.json());
      if (moderationRes.ok) setModerationQueue(await moderationRes.json());
      if (auditRes.ok) setAuditLogs(await auditRes.json());
      if (funnelRes.ok) setReunionFunnel(await funnelRes.json());
      if (durationRes.ok) setReunionDurationStats(await durationRes.json());
      if (deletedArchiveRes.ok) setDeletedPostsArchive(await deletedArchiveRes.json());
    } catch (err) {
      console.error(err);
    } finally {
      setLoading(false);
    }
  };

