  const handleResolveReport = async (id: number) => {
    try {
      const res = await fetch(`/api/admin/reports/${id}/resolve`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (res.ok) {
        setReports(reports.map(r => r.id === id ? { ...r, status: 'resolved' } : r));
      }
    } catch (err) {
      console.error(err);
    }
  };

  const [isAiAnalyzing, setIsAiAnalyzing] = useState<number | null>(null);

  const handleAiAnalyze = async (postId: number) => {
    setIsAiAnalyzing(postId);
    try {
      const post = posts.find(p => p.id === postId);
      if (!post) throw new Error("Post not found");

      const apiKey = process.env.GEMINI_API_KEY;
      if (!apiKey) throw new Error("API key missing");
      
      const ai = new GoogleGenAI({ apiKey });
      const prompt = `
        以下の「再会のボトルメール」の投稿内容を分析し、不適切な内容（誹謗中傷、個人情報の過度な露出、公序良俗に反する内容など）が含まれていないか判定してください。
        
        投稿者名: ${post.searcher_name}
        対象者名: ${post.target_name}
        メッセージ: ${post.message}
        
        結果は以下のJSON形式で返してください：
        {
          "is_flagged": boolean,
          "reason": "理由（不適切な場合のみ、日本語で）"
        }
      `;

      const response = await ai.models.generateContent({
        model: "gemini-3-flash-preview",
        contents: [{ parts: [{ text: prompt }] }],
        config: {
          responseMimeType: "application/json"
        }
      });

      const result = JSON.parse(response.text || '{}');
      
      // Update backend with the result
      const updateRes = await fetch(`/api/admin/posts/${postId}/ai-flag`, {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}` 
        },
        body: JSON.stringify({
          ai_flagged: result.is_flagged ? 1 : 0,
          ai_reason: result.reason || null
        })
      });

      if (updateRes.ok) {
        setStatusMsg({
          text: `AI分析完了: ${result.is_flagged ? '⚠️ 不適切な内容を検知しました' : '✅ 適切な内容です'}`,
          type: result.is_flagged ? 'error' : 'success'
        });
        // Refresh data
        const [postsRes, modRes] = await Promise.all([
          fetch('/api/admin/posts', { headers: { 'Authorization': `Bearer ${token}` } }),
          fetch('/api/admin/moderation-queue', { headers: { 'Authorization': `Bearer ${token}` } })
        ]);

        if (postsRes.ok) {
          const updatedPosts = await postsRes.json();
          setPosts(updatedPosts);
          // Update selectedPost if it's the one being analyzed
          if (selectedPost && selectedPost.id === postId) {
            const updatedPost = updatedPosts.find((p: any) => p.id === postId);
            if (updatedPost) setSelectedPost(updatedPost);
          }
        }
        if (modRes.ok) setModerationQueue(await modRes.json());
      } else {
        throw new Error("Failed to update flag status");
      }
    } catch (err) {
      console.error("AI analysis error:", err);
      setStatusMsg({ text: "AI分析に失敗しました。APIキーの設定などを確認してください。", type: 'error' });
    } finally {
      setIsAiAnalyzing(null);
      setTimeout(() => setStatusMsg(null), 5000);
    }
  };

  const [isSending, setIsSending] = useState(false);
  const [statusMsg, setStatusMsg] = useState<{text: string, type: 'success' | 'error'} | null>(null);
  const [showBulkConfirm, setShowBulkConfirm] = useState(false);
  const [pendingNotification, setPendingNotification] = useState<{content: string, link: string} | null>(null);

  const handleDeleteBroadcast = async (broadcast: any) => {
    showConfirm('通知の削除', 'この一括配信通知を削除しますか？（全ユーザーの通知一覧から消去されます）', async () => {
      try {
        const response = await fetch('/api/admin/broadcasts', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({
            content: broadcast.content,
            created_at: broadcast.created_at
          })
        });
        if (response.ok) {
          fetchData();
        }
      } catch (err) {
        console.error(err);
      }
