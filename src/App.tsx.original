                );
              case 20: // 安全防衛③（連絡先ステルス）
                return (
                  <div className={containerClass}>
                    <div className={headerClass}>STELATH MASK</div>
                    <div className="flex flex-col gap-1 w-full max-w-[170px] my-auto bg-slate-100 p-2 rounded-xl border border-slate-200">
                      <div className="flex items-center justify-between text-[7px] text-slate-400 font-mono">
                        <span>REGEX SCAN FILTER</span>
                        <span className="text-rose-500 font-bold font-mono">BLOCKED</span>
                      </div>
                      <div className="flex flex-col gap-0.5 mt-1">
                        <span className="text-[8px] text-slate-400 line-through">LINE ID: my_id_123</span>
                        <span className="text-[8.5px] text-rose-600 font-bold">LINE ID: ****</span>
                      </div>
                    </div>
                    <p className="text-[9px] text-[#3B627F] text-center font-bold mt-1 font-sans">
