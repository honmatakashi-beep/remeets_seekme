const GuidelinesPage = () => (
  <div className="max-w-4xl mx-auto px-6 py-12 font-serif text-black">
    <Link to="/" className="inline-flex items-center gap-2 text-sm opacity-60 hover:opacity-100 mb-4 font-serif">
      <ArrowLeft size={16} />
      <span>トップへ戻る</span>
    </Link>
    <div className="glass-card p-8 md:p-16">
      <div className="flex items-center gap-4 mb-12">
        <div className="w-14 h-14 rounded-2xl bg-brand-primary/10 flex items-center justify-center text-black">
          <Sparkles size={32} />
        </div>
        <h1 className="text-3xl md:text-4xl font-bold text-black font-serif">投稿ガイドライン</h1>
      </div>
      <div className="space-y-6 text-brand-dark/90 leading-relaxed text-sm font-sans font-serif text-black">
        <p>
        </p>
        <section className="space-y-3">
          <h3 className="text-lg font-bold border-b border-brand-border pb-2 text-black">1. 健全な再会のための基本方針</h3>
          <p>
            メッセージやクイズの設定は、特定のお相手が、あなたとの共通の想い出を懐かしく振り返り、心温まる再会ができる内容に限定してください。攻撃的、執着的な表現や、相手を戸惑わせるような書き込みは厳禁です。
          </p>
        </section>
        <section className="space-y-3">
          <h3 className="text-lg font-bold border-b border-brand-border pb-2 text-black">2. 禁止される投稿内容</h3>
          <ul className="list-disc pl-5 space-y-1.5 text-black/80">
            <li><strong>個人を特定する情報の直接掲載:</strong> フルネーム、電話番号、詳細な住所、学校・会社名、特定のSNSハンドル（LINE ID等）の直接入力は制限されます。お互いしか知り得ないエピソードで表現してください。</li>
            <li><strong>他者への誹謗中傷・嫌がらせ:</strong> 特定の個人を侮辱・批判したり、プライバシーを侵害するおそれのある投稿は固く禁止します。</li>
            <li><strong>ストーカー行為・一方的な付きまとい:</strong> 相手が恐怖や嫌悪感を抱くような執念的な表現、または一方的な恋愛感情の押し付けなどはAI判定及び目視で即座に検知され、非公開化・削除の対象となります。</li>
            <li><strong>性的、暴力的な表現:</strong> 公序良俗に反するテキストや品位を欠く表現の投稿。</li>
          </ul>
        </section>
        <section className="space-y-3">
          <h3 className="text-lg font-bold border-b border-brand-border pb-2 text-black">3. リアルタイム自動検知と管理者等への緊急通報</h3>
          <p>
            ボトルメールが投函された際、またはチャットメッセージが送信された際、高度なAI（Gemini API）および安全NGワード自動検知システムがバックグラウンドで作動します。
            脅迫行為、嫌がらせ、売春や援助交際・パパ活など違法または不適当な書き込みが行われた場合は、システムが瞬時に自動非公開（または伏字）処理を適用した上で、<strong>管理者に対して即時通報</strong>を行います。管理者は通報を受け、直ちに対象アカウントの凍結処分や完全なデータ消去手続きを実施します。
          </p>
        </section>
      </div>
    </div>
  </div>
);

