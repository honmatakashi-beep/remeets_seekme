const SafetyPage = () => (
  <div className="max-w-4xl mx-auto px-6 py-12 md:py-24 text-black font-sans">
    <Link to="/" className="inline-flex items-center gap-2 text-sm opacity-60 hover:opacity-100 mb-6 font-serif text-black">
