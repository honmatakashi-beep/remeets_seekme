                  <>
                    <RefreshCw className="animate-spin" size={15} />
                    <span>送信中...</span>
                  </>
                ) : (
                  <>
                    <ShieldAlert size={15} />
                    <span>通報を安全に送信</span>
                  </>
                )}
              </button>
            </div>
          </form>
        )}
      </motion.div>
    </div>
  );
};



