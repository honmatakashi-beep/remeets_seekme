                type="button" 
                onClick={onClose} 
                className="w-1/3 py-2.5 px-4 rounded-xl border border-slate-300 text-slate-600 text-xs font-bold hover:bg-slate-50 transition-colors cursor-pointer"
              >
                キャンセル
              </button>
