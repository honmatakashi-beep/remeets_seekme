      </motion.div>

      <TermsModal 
        isOpen={showTerms} 
        onClose={() => setShowTerms(false)} 
        onConfirm={() => {
          setHasReadTerms(true);
          if (hasReadPrivacy) setAgreed(true);
        }}
      />

      <TermsModal 
        isOpen={showPrivacy} 
        mode="privacy"
        onClose={() => setShowPrivacy(false)} 
        onConfirm={() => {
          setHasReadPrivacy(true);
          if (hasReadTerms) setAgreed(true);
        }}
      />
    </div>
  );
};

