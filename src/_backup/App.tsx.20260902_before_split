const useNgFilter = () => {
  const check = (val: string): string | null => {
    // Basic fallback check for harmful phrases or placeholders
    const badPatterns = ['死ね', '殺す', '痴漢', '援助交際', '買春'];
    for (const pattern of badPatterns) {
      if (val.includes(pattern)) return pattern;
    }
    return null;
  };
  return { check };
};

