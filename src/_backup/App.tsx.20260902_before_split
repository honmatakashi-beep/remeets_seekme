    const ngLabel = checkNg(name);
    setWarnings(prev => ({ ...prev, searcherName: ngLabel ? `禁止文字（${ngLabel}）が含まれています。` : null }));
    setFormData({...formData, searcherName: name});
    checkRealName(name);
