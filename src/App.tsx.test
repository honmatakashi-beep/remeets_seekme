      { id: 10, category: "SNS連携", title: "LINE_CHANNEL_SECRET 等の認証シークレットの環境変数追記", description: "安全なSNS認証（OAuth）を行うために、本番用クライアントIDと秘密鍵をサーバー側の本番環境変数にインジェクトします。", completed: false, date: "", notes: "" },
      { id: 11, category: "法務・規約", title: "利用規約（TOS）のSNSアカウント連携条項追加・改訂", description: "利用規約のセキュリティ項目に、SNS使い捨てアカウントによる大量連続登録の禁止や、連携解除時のデータ取扱規程を追加します。", completed: false, date: "", notes: "" },
      { id: 12, category: "法務・規約", title: "プライバシーポリシー（PP）のOAuth取得データ明記・改訂", description: "SNSログイン経由で取得するプロファイル画像、氏名、メールアドレスの厳格な利用範囲とセキュリティ転送条件をポリシーに追加します。", completed: false, date: "", notes: "" },
      { id: 13, category: "法務・規約", title: "特定商取引法に基づく表記の整備（住所・電話番号対策）", description: "バーチャルオフィス住所・050電話番号を契約し、個人のプライバシーと自宅特定を防ぎつつ特定商取引法ページに公式掲載します。", completed: false, date: "", notes: "" },
      { id: 14, category: "セキュリティ", title: "Firestore 自動バックアップ ＆ データの保護ルール設定", description: "万が一のデータ損失やアタックに備え、Firebase / Google Cloud での自動バックアップ世代管理スケジュールを有効化します。", completed: false, date: "", notes: "" },
      { id: 15, category: "セキュリティ", title: "スロットリング型動的APIアクセスレート制限のポリシー設定", description: "DoS攻撃やクイズの総当たり自動回答スパムを防ぐため、管理画面から秒間API制限しきい値を調整・固定します。", completed: false, date: "", notes: "" },
      { id: 16, category: "最終テスト", title: "公的 eKYC・自筆署名・Stripeテスト決済の最終疎通テスト", description: "お相手とのチャット開通手数料決済、自筆の署名、本人確認書類アップロード、マッチングメールの到達が正常に機能するか最終検証します。", completed: false, date: "", notes: "" },
    ];

    try {
      const saved = localStorage.getItem('remeets_deploy_checklist_progress');
      if (saved) {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed)) {
          const merged = defaultItems.map(defItem => {
            const savedItem = parsed.find((p: any) => p.id === defItem.id);
            if (savedItem) {
              return {
                ...defItem,
                completed: !!savedItem.completed,
                date: savedItem.date || "",
                notes: savedItem.notes || ""
              };
            }
            return defItem;
          });
          localStorage.setItem('remeets_deploy_checklist_progress', JSON.stringify(merged));
          return merged;
        }
      }
    } catch (e) {
      console.warn('localStorage read or auto-migration failed:', e);
    }
    return defaultItems;
  });

  const [operationChecklistItems, setOperationChecklistItems] = React.useState<any[]>(() => {
    const defaultOps = [
      { id: 1, category: "認証・セキュリティ基盤", title: "LINE / Google OAuthログイン連携テスト", description: "開発者ポータルで設定したLINE/Googleログインが本番ドメインで正常に起動し、ユーザープロファイル（ニックネーム、画像、メールアドレス）が正常に取得できるか検証します。", completed: false, date: "", notes: "" },
