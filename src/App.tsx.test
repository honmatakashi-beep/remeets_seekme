                    className={`w-full text-left px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer flex items-center gap-2 ${
                      docType === type
                        ? "bg-[#3B627F] text-white shadow-sm ring-2 ring-[#3B627F]/20"
