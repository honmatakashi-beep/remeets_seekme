              <div className="text-[11px] font-bold text-slate-600 uppercase tracking-wider px-1">運営戦略広報＆評価</div>
              <div className="flex flex-col gap-2 mt-2">
                {(["slides", "evaluation", "pr_plan"] as const).map((type) => (
                  <button
                    key={type}
