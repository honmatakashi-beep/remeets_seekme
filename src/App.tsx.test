      { id: 3, category: "認証・セキュリティ基盤", title: "不正ログイン・IPスロットリング（レート制限）テスト", description: "過度な連続アクセスや不当IPからの接続に対して、動的な接続レート制限およびIPアクセス制限が正しく遮断動作するか検証します。", completed: false, date: "", notes: "" },
      { id: 4, category: "ボトル投函・検閲", title: "ボトル（手紙）の新規作成 ＆ クイズ登録テスト", description: "手紙本文、共通の想い出クイズ（質問・正解）の各入力項目が、データベースに破損なく正しく保存・投函されるか検証します。", completed: false, date: "", notes: "" },
      { id: 5, category: "ボトル投函・検閲", title: "フルネーム判定（常用姓名辞書）ガード検証", description: "プロフィール登録やボトル見出し、手紙内に日本の常用姓名辞書に基づくフルネーム（漢字・典型的な姓名配列）を入力した際、検閲ブロックされるか検証します。", completed: false, date: "", notes: "" },
      { id: 6, category: "ボトル投函・検閲", title: "AI自動検閲（誹謗中傷・出会い系不当表現）フィルターテスト", description: "手紙本文にわいせつ表現や直接の連絡先（電話番号、他SNSのID）、ストーカー的接近文言を入力し、AIモデレーションが自動で「非公開」に隔離するか検証します。", completed: false, date: "", notes: "" },
      { id: 7, category: "漂流検索・アビューズ防止", title: "ボトル引き揚げ ＆ クイズ完全一致テスト", description: "想い出クイズ検索画面で、登録された質問に完全正解（または設定された表記ゆれ許容範囲内）した場合にのみ、手紙のプレビューが許可されるか検証します。", completed: false, date: "", notes: "" },
      { id: 8, category: "漂流検索・アビューズ防止", title: "クイズ総当たり（総当たりアビューズ試行）制限テスト", description: "同一ボトルに対して連続で不正解の回答を試行した場合（5回以上など）に、一定時間ロックアウトされ、アビューズ記録ログが残るか検証します。", completed: false, date: "", notes: "" },
      { id: 9, category: "漂流検索・アビューズ防止", title: "お相手からのメッセージ受信・通知連携テスト", description: "クイズを突破された手紙の所有者に対し、お相手がクイズを解いたことを知らせる通知イベントや確認シグナルが正常動作するか検証します。", completed: false, date: "", notes: "" },
      { id: 10, category: "開通決済・自筆署名", title: "自筆電子署名（タッチ描画・誓約書）保存テスト", description: "メッセージ開通前の「誓約確認」画面で、指やマウスによる手書き自筆署名が正常に描画され、署名画像/ベクトルデータがタイムスタンプと共に安全保存されるか検証します。", completed: false, date: "", notes: "" },
      { id: 11, category: "開通決済・自筆署名", title: "Stripeモック / 本番決済（開通手数料600円）疎通テスト", description: "開通ボタン押下時にStripe Checkout画面に安全に遷移し、模擬クレジットカードまたは実決済で600円の決済処理が遅延なく完了するか検証します。", completed: false, date: "", notes: "" },
