              {/* NEW: ⑤ 模擬監査ログ（CSVエクスポート）の意味と見かた */}
              <div className="glass-card p-6 space-y-4 md:col-span-2">
                <div className="flex items-center gap-3 border-b border-brand-border pb-3">
