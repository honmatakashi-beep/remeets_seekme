                  >
                    <span className="opacity-75 bg-slate-200/50 text-slate-800 rounded-lg px-2 py-0.5 text-[10px] shrink-0 min-w-[24px] text-center">
                      {type === "slides" && "⑥"}
                      {type === "evaluation" && "⑨"}
                      {type === "pr_plan" && "⑩"}
